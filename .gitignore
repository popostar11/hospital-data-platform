node_modules/
dist/
*.log
.env
.env.local
.DS_Store
.vite/
*.tsbuildinfo

# 运行时数据目录：数据库、上传附件、启动器生成的 pnpm 转发脚本
# SQLite 会额外产生 -wal / -shm 临时文件，一并忽略
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/.bin/
data/uploads/
# 守护进程 PID 文件：每次启停都会变，属于运行时状态，不进版本库
data/daemon.pid

# 启动器日志
logs/

# ---------------------------------------------------------------------------
# 隐私与合规：以下内容**不得**进入公开仓库
#   tu/                    现场实拍照片与录像（含真实机构名称与院内环境）
#   docs/refs/0*.jpg       按现场大屏裁剪的参考图（画面上含真实机构名称）
# 仓库只保留用脱敏演示数据渲染出来的截图（docs/refs/*.png）。
# ---------------------------------------------------------------------------
tu/
docs/refs/0*.jpg

# Cloudflare Workers 相关产物与本地状态
# 注意：下面几行不要写成「模式  # 注释」的形式 —— .gitignore 不支持行尾注释，
# 整行都会被当成模式，导致文件被误加入版本库。
#
# public/    由 apps/worker/scripts/build-assets.mjs 汇总生成
# seed.sql   由 tools/export-d1-seed.mjs 生成（约 5MB，含演示数据）
# .dev.vars  本地开发用的密钥
# .wrangler/ 本地 D1 数据与构建缓存
apps/worker/public/
apps/worker/seed.sql
apps/worker/.dev.vars
apps/worker/.wrangler/

