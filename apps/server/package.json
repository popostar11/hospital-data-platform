{
  "name": "@hospital/server",
  "version": "0.1.0",
  "private": true,
  "description": "医院数据管理平台后端 —— NestJS + node:sqlite",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node ../../tools/dev-server.mjs",
    "start": "node dist/main.js",
    "db:init": "node dist/db/init.js",
    "db:seed": "node dist/db/seed.js",
    "db:reset": "node dist/db/reset.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hospital/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "typescript": "^5.6.3"
  }
}
