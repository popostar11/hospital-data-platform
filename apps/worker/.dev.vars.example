# 本地开发用的环境变量（`wrangler dev` 会读取本文件）
# 复制为 .dev.vars 后使用；该文件已在 .gitignore 中排除，不会进仓库。
#
# 线上请改用：wrangler secret put <NAME>

# 登录令牌签名密钥（生产必须替换为随机长字符串）
JWT_SECRET=dev-only-jwt-secret-change-me

# 敏感字段加密主密钥（当前公网演示版不启用明文查看，仅保留占位）
CRYPTO_KEY=dev-only-crypto-key-change-me

# 种子数据导入令牌：调用 POST /api/v1/admin/seed?token=xxx 时校验
SEED_TOKEN=dev-only-seed-token-change-me

# 演示模式：大屏允许匿名只读
DEMO_MODE=true
