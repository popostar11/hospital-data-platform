# ============================================================================
#  医院数据管理平台 · 环境变量模板
#
#  用法：复制本文件为 .env（同目录），按需修改。不建 .env 时全部使用代码默认值。
#  优先级：真实环境变量 > .env > 代码默认值
#
#  ⚠ 生产部署必须修改 JWT_SECRET 与 CRYPTO_KEY：
#    前者用于签发登录令牌，后者用于加密患者姓名/身份证/手机号。
#    一旦 CRYPTO_KEY 变更，已加密的历史数据将无法解密，务必先备份。
# ============================================================================

# ---------------------------------------------------------------- 服务
# 监听端口与地址（0.0.0.0 表示允许局域网访问）
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------- 安全
# 登录令牌签名密钥（生产必须替换为随机长字符串）
JWT_SECRET=hospital-platform-dev-secret-change-me
# 访问令牌有效期（秒），默认 2 小时
JWT_EXPIRES_IN=7200
# 刷新令牌有效期（秒），默认 7 天
REFRESH_EXPIRES_IN=604800
# 敏感字段加密主密钥（患者姓名/身份证/手机号，生产必须替换）
CRYPTO_KEY=hospital-platform-dev-crypto-key-change-me
# 登录失败锁定：连续失败次数与锁定时长（分钟）
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=15
# 登录图形验证码（内网演示默认关闭）
CAPTCHA_ENABLED=false

# ---------------------------------------------------------------- 数据
# 数据库文件位置（默认 <项目根>/data/hospital.db）
# DB_FILE=D:\hospital-data\hospital.db
# 运行时数据目录（数据库、上传附件）
# DATA_DIR=D:\hospital-data

# ---------------------------------------------------------------- 大屏
# 大屏聚合数据缓存时长（秒），病例变更时会立即失效
SCREEN_CACHE_TTL=5
# 24 小时表格最多返回条数
SCREEN_TABLE_LIMIT=20
# 演示模式：true 时大屏允许匿名只读访问；
# 生产建议改为 false，大屏终端改用 screen 账号令牌访问（/screen/?token=xxx）
DEMO_MODE=true
